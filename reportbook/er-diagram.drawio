        <mxCell id="reg_r6" value="&#9671;  address VARCHAR(255)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1358" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r7" value="&#9671;  date_of_birth / gender" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1388" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r8" value="&#9671;  status VARCHAR(20)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1418" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r9" value="&#9671;  created_at TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1448" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r10" value="&#9671;  reviewed_at TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1478" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r11" value="&#9671;  reviewed_by VARCHAR(50) (no FK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1508" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_r12" value="&#9671;  rejection_reason TEXT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1538" width="280" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="reg_idx" value="Indexes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d0d0d0;strokeColor=#d9d9d9;align=left;verticalAlign=middle;spacingLeft=10;fontSize=12;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="1568" width="280" height="24" as="geometry"/>
        </mxCell>

        <!-- ============================================================ -->
        <!-- RELATIONSHIPS - enforced FKs (solid navy, crow's-foot)        -->
        <!-- Connected directly to the PK/FK row cells, not the tables.    -->
        <!-- ============================================================ -->

        <!-- department.department_id -> doctor.department_id (1:N), same row, corridor A -->
        <mxCell id="e_dept_doc" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dept_r1" target="doc_r4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- doctor.doctor_id -> doctor_schedule.doctor_id (1:N), same row, corridor B -->
        <mxCell id="e_doc_sched" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="doc_r1" target="sched_r2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- department.department_id -> queue.department_id (1:N, snapshot), full-height corridor A -->
        <mxCell id="e_dept_q" value="1:N (snapshot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dept_r1" target="q_r5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- doctor.doctor_id -> queue.doctor_id (1:N); doctor and queue share column 2, so
             detour sideways through the clear corridor to the right of both (corridor B) -->
        <mxCell id="e_doc_q" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="doc_r1" target="q_r4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="680" y="135"/>
              <mxPoint x="680" y="739"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- patient.patient_id -> queue.patient_id (1:N), same row, corridor A -->
        <mxCell id="e_pat_q" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pat_r1" target="q_r3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- department.department_id -> appointment.department_id (1:N, snapshot); crosses
             column 2 via the clear row1/row2 gap band (y=552), then corridor B down into appt -->
        <mxCell id="e_dept_appt" value="1:N (snapshot)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dept_r1" target="appt_r4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="345" y="552"/>
              <mxPoint x="700" y="552"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- doctor.doctor_id -> appointment.doctor_id (1:N), corridor B is clear its full height -->
        <mxCell id="e_doc_appt" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="doc_r1" target="appt_r3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- patient.patient_id -> appointment.patient_id (1:N); patient and appointment are
             both in row 2 with queue between them, so jog up into the row1/row2 gap band
             (y=595, above queue's top) before crossing into corridor B -->
        <mxCell id="e_pat_appt" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pat_r1" target="appt_r2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="360" y="595"/>
              <mxPoint x="705" y="595"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- patient.patient_id -> notification.patient_id (1:N); same gap-band technique,
             routed further right past appointment's column into notification -->
        <mxCell id="e_pat_notif" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1a5276;strokeWidth=2;fontSize=10;fontColor=#1a5276;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="pat_r1" target="notif_r2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="365" y="580"/>
              <mxPoint x="1045" y="580"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============================================================ -->
        <!-- RELATIONSHIPS - application-level only (dashed grey,          -->
        <!-- open arrow, no crow's-foot) - no REFERENCES in the schema     -->
        <!-- ============================================================ -->

        <!-- queue.queue_id <-> appointment.queue_id: appointment.queue_id has no FK constraint -->
        <mxCell id="e_q_appt" value="app-level link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q_r1" target="appt_r8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- queue.queue_id -> queue_history.queue_id: no FK constraint, historical/log link -->
        <mxCell id="e_q_qhist" value="logs (app-level)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="q_r1" target="qhist_r2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- admin_user.admin_id -> patient_registration_request.reviewed_by: no FK, admin
             reviews the request; routed via the clear right margin then the row2/row3 gap band -->
        <mxCell id="e_admin_reg" value="reviews (app-level)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="admin_r1" target="reg_r11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1710" y="135"/>
              <mxPoint x="1710" y="1140"/>
              <mxPoint x="345" y="1140"/>
              <mxPoint x="345" y="1523"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- patient_registration_request -> patient: approval creates a new patient row; a
             business process, not a stored FK. Same column, direct vertical in the clear gap -->
        <mxCell id="e_reg_pat" value="creates upon approval" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reg" target="pat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- staff -> audit_log.user_id: polymorphic actor reference, no FK -->
        <mxCell id="e_staff_audit" value="actor (polymorphic)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=1;entryY=0.35;" edge="1" parent="1" source="staff" target="audit_r2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1370" y="252"/>
              <mxPoint x="1370" y="1150"/>
              <mxPoint x="1010" y="1150"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- admin_user -> audit_log.user_id: polymorphic actor reference, no FK -->
        <mxCell id="e_admin_audit" value="actor (polymorphic)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;fontColor=#666666;strokeColor=#999999;endArrow=open;endFill=0;startArrow=none;exitX=1;exitY=0.5;entryX=1;entryY=0.65;" edge="1" parent="1" source="admin" target="audit_r2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1710" y="237"/>
              <mxPoint x="1710" y="1160"/>
              <mxPoint x="1015" y="1160"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============================================================ -->
        <!-- NOTES - kept small and placed beside the tables they explain  -->
        <!-- ============================================================ -->

        <mxCell id="note1" value="Snapshot FKs: QUEUE.department_id and APPOINTMENT.department_id are captured at booking time. DOCTOR.department_id stays the source of truth; the snapshot keeps history accurate if a doctor later transfers department." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="970" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note2" value="No stored FK: APPOINTMENT.queue_id and QUEUE_HISTORY.queue_id / patient_id / doctor_id are plain columns with no REFERENCES clause (see V1__create_schema.sql) - application-level links only." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="970" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="Polymorphic actor: AUDIT_LOG.user_id + user_type together identify a STAFF or ADMIN_USER row. One column can't hold an enforced FK to two parent tables, so this pair is validated in application code." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="1485" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="note4" value="No stored FK: PATIENT_REGISTRATION_REQUEST.reviewed_by has no REFERENCES clause, and request -&gt; patient is a business process (admin approval creates a new PATIENT row), not a stored foreign key." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;size=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1635" width="280" height="100" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
