# ============================================================
# Hospital Smart Queue System - environment configuration
# Copy this file to .env and fill in your real credentials.
# ============================================================

# ---------- Neon Cloud Database (PostgreSQL) ----------
# From Neon console -> Connection Details. Paste your connection string as-is
# (e.g. postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require).
# The app automatically converts "postgresql://" to the JDBC form.
NEON_DATABASE_URL=postgresql://USER:PASSWORD@EP-SUBDOMAIN.REGION.aws.neon.tech/hospital_queue?sslmode=require
NEON_USER=USER
NEON_PASSWORD=PASSWORD

# ---------- OpenRouter AI (free models) ----------
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY
# Free tier model used for symptom -> department/doctor recommendation
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------- RAG chatbot ----------
# Optional: override the location of the chatbot's knowledge-base text files
KNOWLEDGE_BASE_PATH=classpath:knowledge-base/*.txt

# ---------- Server ----------
SERVER_PORT=8080
